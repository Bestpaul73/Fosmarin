{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/(?:about|challenge|use-cases|technology|consortium|news|resources|contact)/?$",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "status": 404,
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    }
  ]
}
